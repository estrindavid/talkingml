{
  "name": "talkingml",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "quarto render",
    "check": "npm run types:check && npm run typecheck && npm run build && npm run validate:site && npm test && npm run deploy:dry-run",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler.log wrangler d1 migrations apply talkingml-views-local --local",
    "deploy:dry-run": "WRANGLER_LOG_PATH=.wrangler.log wrangler deploy --dry-run",
    "dev": "WRANGLER_LOG_PATH=.wrangler.log wrangler dev",
    "preview": "quarto preview",
    "test": "WRANGLER_LOG_PATH=.wrangler.log vitest run",
    "test:watch": "WRANGLER_LOG_PATH=.wrangler.log vitest",
    "typecheck": "tsc --noEmit",
    "types": "WRANGLER_LOG_PATH=.wrangler.log wrangler types --env-interface Env worker-configuration.d.ts",
    "types:check": "npm run types && git diff --exit-code -- worker-configuration.d.ts",
    "validate:site": "node scripts/validate-site.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
