{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "talkingml",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "talkingml.com",
      "custom_domain": true
    },
    {
      "pattern": "www.talkingml.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "VIEWS_DB",
      "database_name": "talkingml-views",
      "database_id": "82b559a3-a676-4a9b-903a-b86a230e77ec",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
